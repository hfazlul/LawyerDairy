# Copy to .env for local `vercel dev` testing. In production, set these as
# Vercel Project → Settings → Environment Variables instead.

# From ShelfAware Android app: google-services.json → project_id
FIREBASE_PROJECT_ID=shelfaware-ee460
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@shelfaware-ee460.iam.gserviceaccount.com
# Keep the literal \n sequences — firestore.js converts them back to real newlines.
# When these three are empty, the agent reads SHELFAWARE_FIREBASE_SERVICE_ACCOUNT_JSON,
# then FIREBASE_SERVICE_ACCOUNT_JSON (the model health checker's name).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExamplePlaceholderKeyNotReal\n-----END PRIVATE KEY-----\n"

GEMINI_FREE_API_KEY=

# Paid Gemini + Google Custom Search are unused (slots skip if unset). Do not add keys.
# GEMINI_PAID_API_KEY=
# PAID_BUDGET_USD=
# GEMINI_PAID_GROUNDING=
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=

# Comma-separated key pools — the agent rotates to the next key when one sleeps.
# When GROQ_KEYS is empty the agent uses GROQ_API_KEY (model health checker).
# When OPENROUTER_KEYS is empty the agent uses OPENROUTER_API_KEY.
GROQ_KEYS=
OPENROUTER_KEYS=
HF_API_TOKEN=

# Any long random string. Vercel's own cron auto-sends this as
# `Authorization: Bearer $CRON_SECRET` — but you MUST set it yourself too if
# you're triggering this endpoint from an external scheduler (see README).
CRON_SECRET=any_random_secure_string

# Code default is 8000 (Hobby-safe). Raise only on Pro with maxDuration extended.
FUNCTION_TIME_BUDGET_MS=8000
