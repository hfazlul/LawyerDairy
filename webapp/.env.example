# Database
DATABASE_URL="postgresql://user:password@localhost:5432/lawyer_db"

# JWT — generate with: openssl rand -base64 64
JWT_SECRET="your-very-long-random-secret-here"
JWT_ACCESS_TTL_MIN="15"
JWT_REFRESH_TTL_DAYS="30"

# SMS Gateway — skip send if empty.
# Hearing/bulk posts JSON to DynamicSMSApi. Password OTP posts form fields to smsSendApi.
# portal.sms.net.bd is off on purpose. A failed send does not try a second provider.
# Paste BULKSMS24_API_KEY on the server .env only. Never commit it.
# SMS_CUSTOMER_ID is the dashboard customer id (not the API key).
SMS_MODE=""
SMS_CUSTOMER_ID="1684"
# Generic gateway. A URL on sms.net.bd is not used.
SMS_API_URL=""
SMS_API_KEY=""
SMS_API_SECRET=""
SMS_SENDER_ID="LawyerDiary"
SMS_VENDOR_STYLE="form_post"
# bearer_json | json_body | form_post | query_get | query_post
SMS_KEY_IN="body"
SMS_KEY_FIELD="api_key"
SMS_TO_FIELD="to"
SMS_MESSAGE_FIELD="msg"
SMS_SENDER_FIELD="sender_id"
SMS_PHONE_FORMAT="local01"
# SMS_HTTP_METHOD=""
# SMS_SECRET_FIELD=""
# SMS_EXTRA_FIELDS=""
# SMS_SUCCESS_CONTAINS=""
# SMS_FAIL_CONTAINS=""

# portal.sms.net.bd is off on purpose and is not used to send.
# SMS_NET_BD_URL="https://api.sms.net.bd/sendsms"
# SMS_NET_BD_API_KEY=""

# 24bulksmsbd. Hearing/bulk uses DynamicSMSApi. Password OTP uses smsSendApi.
# Empty key = skip. Aliases: SMS_FAILOVER_KEY, BULKSMSBD_API_KEY.
# A BULKSMS24_URL that still points at smsSendApi is ignored; sends use DynamicSMSApi.
# BULKSMS24_URL="https://www.24bulksmsbd.com/api/DynamicSMSApi"
# BULKSMS24_API_KEY=""
# SMS_FAILOVER_URL=""
# SMS_FAILOVER_KEY=""

# Optional hosted legal URLs (https). Empty = in-app Data Safety summary only.
PRIVACY_POLICY_URL=""
TERMS_URL=""
CONTACT_URL=""
GUIDE_BD_URL=""
# GUIDE_PART_1_URL=""
# GUIDE_PART_2_URL=""
# GUIDE_PART_3_URL=""
# GUIDE_CARD_JSON=""

# Cloud OCR / case AI / WhatsApp Cloud — adapters 503 until set
OCR_API_URL=""
OCR_API_KEY=""
CASE_AI_API_URL=""
CASE_AI_API_KEY=""
WABA_TOKEN=""
WABA_PHONE_NUMBER_ID=""

# Postgres RLS policies (prisma/rls.sql). Off unless ENABLE_PG_RLS=1.
# API already SET LOCAL app.workspace_id on sync + SMS paths.
# ENABLE_PG_RLS="1"

# ── Email (Brevo primary + Resend fallback) ───────────────────────────────────
# Local: leave keys empty → dry-run (success + console log, no real send).
MAIL_DOMAIN="lawyerdiarybd.com"
EMAIL_PROVIDER="auto"
EMAIL_PRIMARY="brevo"
EMAIL_FALLBACK="resend"
BREVO_API_KEY=""
RESEND_API_KEY=""
MAIL_FROM_DEALS="Lawyer Diary BD <deals@lawyerdiarybd.com>"
MAIL_FROM_NOREPLY="Lawyer Diary BD <noreply@lawyerdiarybd.com>"
MAIL_FROM_SUPPORT="Lawyer Diary BD <support@lawyerdiarybd.com>"
MAIL_DAILY_LIMIT="300"

# Cloudflare R2 / AWS S3 (document storage)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret"
R2_BUCKET_NAME="lawyer-diary-docs"
R2_PUBLIC_URL="https://docs.lawyerdiarybd.com"

# SSLCommerz (BD payment gateway) — web checkout only; never in mobile BD UI
SSLCOMMERZ_STORE_ID="your-store-id"
SSLCOMMERZ_STORE_PASS="your-store-password"
SSLCOMMERZ_IS_LIVE="false"

# Public app / store / guide videos (Bangladesh only)
# Public origin for ZiniPay redirect_url / cancel_url / webhook_url.
# Production brand website is https://mamlaq.com (homepage only in the ZiniPay Brands field).
# Return, cancel, and webhook are routes on that host, not the brand field.
# Unset env, http://mamlaq.com, www, and http://187.77.153.28 all become https://mamlaq.com.
# Local dev may keep http://localhost:3000. Phone debug API is separate and stays on the VPS IP.
PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PLAY_STORE_URL="https://play.google.com/store/apps/details?id=com.mamlaq.app"
# Optional YouTube embed override. Empty = landing shows honest empty (no rickroll).
# Mobile also reads GUIDE_BD_URL (https YouTube watch/embed). Do not invent a video.
NEXT_PUBLIC_GUIDE_BD_EMBED=""

# Seed overrides
# SEED_ADMIN_EMAIL="admin@lawyerdiarybd.com"
# SEED_ADMIN_PASSWORD="ChangeMeAdmin!234"
# SEED_ADMIN_PHONE="+8801700000000"

# Security
RATE_LIMIT_AUTH_PER_MIN="60"
RATE_LIMIT_API_PER_MIN="120"
CSRF_SECRET="change-me-csrf-secret"

NODE_ENV="development"

# Cron (account purge + FCM reminder jobs). Required for POST/GET /api/mobile/v1/cron/*.
# Generate locally: openssl rand -hex 32
CRON_SECRET=""
# INTERNAL_CRON_SECRET=""

# ZiniPay (website checkout only — never in Play APK)
# Docs: https://api.zinipay.com  POST /v1/payment/create + /v1/payment/verify
# Header: zini-api-key (set ZINIPAY_API_KEY_HEADER=zinipay-api-key if the panel uses that name).
# Aliases: ZINI_API_KEY, ZINIPAY_KEY, ZINI_PAY_API_KEY, ZINIPAY_SECRET, ZINIPAY_TOKEN.
# The docs sample sandbox_test_8f4c9a2e7b31 is never live.
# Other keys starting with sandbox_test_ are not live.
# ZINIPAY_MODE=production refuses those keys even if ZINIPAY_ALLOW_SANDBOX=true.
# A real brand key is accepted in production.
# Paste the Brand Key from the ZiniPay dashboard into ZINIPAY_API_KEY on the server only.
# redirect_url host must match the brand website. Do not put a key in git.
# Fulfill only after /verify returns COMPLETED. Never trust webhook status:true alone.
ZINIPAY_MODE="production"
ZINIPAY_API_KEY=""
# ZINIPAY_API_KEY_HEADER="zini-api-key"
# ZINIPAY_WEBHOOK_SECRET=""
# ZINIPAY_BASE_URL="https://api.zinipay.com"
# ZINIPAY_ALLOW_SANDBOX="false"

# GA4. Public site gtag loads only when this is a real G- Measurement ID (not G-XXXXXXXX).
# Never commit the value. Admin UI shows SET/EMPTY only — never the ID.
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXX"

# Auto WhatsApp / WABA is removed. Do not set weekly WA digest templates.

# Optional override for `npm run cron:fcm` (default is localhost:3000 — does not follow NEXT_PUBLIC_APP_URL)
# CRON_FCM_URL="http://localhost:3000/api/mobile/v1/cron/fcm-reminders"

# Firebase Cloud Messaging (server). Never commit the JSON key file.
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Store JSON outside the git root. Local example (real filename on disk, not in git):
#   GOOGLE_APPLICATION_CREDENTIALS="D:\\VIVI\\1\\secrets\\<firebase-adminsdk>.json"
# Production: set the same path on the host, or paste JSON as a secret env (Vercel / Cloud Run):
#   FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# Leave both empty → cron returns { skipped: "fcm_unconfigured", sent: 0 } (no SMS).
GOOGLE_APPLICATION_CREDENTIALS=""
FIREBASE_SERVICE_ACCOUNT_JSON=""
