# Database
DATABASE_URL="postgresql://user:password@localhost:5432/lawyer_diary_bd"

# JWT — generate with: openssl rand -base64 64
JWT_SECRET="your-very-long-random-secret-here"
JWT_ACCESS_TTL_MIN="15"
JWT_REFRESH_TTL_DAYS="30"

# SMS Gateway (BD — SSL Wireless / BL SMS / BulkSMS) — mobile OTP
SMS_API_URL="https://api.sms-gateway.com/send"
SMS_API_KEY="your-sms-api-key"
SMS_SENDER_ID="LawyerDiary"

# ── Email (Brevo primary + Resend fallback) ───────────────────────────────────
# Local: leave keys empty → dry-run (success + console log, no real send).
MAIL_DOMAIN="lawyerdiarybd.com"
EMAIL_PROVIDER="auto"
EMAIL_PRIMARY="brevo"
EMAIL_FALLBACK="resend"
BREVO_API_KEY=""
RESEND_API_KEY=""
MAIL_FROM_DEALS="Lawyer Diary BD <deals@lawyerdiarybd.com>"
MAIL_FROM_NOREPLY="Lawyer Diary BD <noreply@lawyerdiarybd.com>"
MAIL_FROM_SUPPORT="Lawyer Diary BD <support@lawyerdiarybd.com>"
MAIL_DAILY_LIMIT="300"

# Cloudflare R2 / AWS S3 (document storage)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret"
R2_BUCKET_NAME="lawyer-diary-docs"
R2_PUBLIC_URL="https://docs.lawyerdiarybd.com"

# SSLCommerz (BD payment gateway) — web checkout only; never in mobile BD UI
SSLCOMMERZ_STORE_ID="your-store-id"
SSLCOMMERZ_STORE_PASS="your-store-password"
SSLCOMMERZ_IS_LIVE="false"

# Public app / store / guide videos (jurisdiction-aware)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PLAY_STORE_URL="https://play.google.com/store/apps/details?id=com.lawyerdiary.bd"
# YouTube embed URLs — BD may soft-mention web pay; IN/PK must NOT
NEXT_PUBLIC_GUIDE_BD_EMBED="https://www.youtube.com/embed/dQw4w9WgXcQ"
NEXT_PUBLIC_GUIDE_IN_EMBED="https://www.youtube.com/embed/dQw4w9WgXcQ"
NEXT_PUBLIC_GUIDE_PK_EMBED="https://www.youtube.com/embed/dQw4w9WgXcQ"

# Seed overrides
# SEED_ADMIN_EMAIL="admin@lawyerdiarybd.com"
# SEED_ADMIN_PASSWORD="ChangeMeAdmin!234"
# SEED_ADMIN_PHONE="+8801700000000"

# Security
RATE_LIMIT_AUTH_PER_MIN="60"
RATE_LIMIT_API_PER_MIN="120"
CSRF_SECRET="change-me-csrf-secret"

NODE_ENV="development"
