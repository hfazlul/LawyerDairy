# Copy to .env for local runs (never commit).
# Or set these in the shell before: python tools/model_health_check.py
# run-local.ps1 will load this file automatically if it exists.

GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_FREE_API_KEY=
HF_API_TOKEN=

# Path to the Firebase Admin JSON (preferred on Windows), OR paste the JSON as one line.
# Local: ./service-account.json   GitHub secret: paste the full JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=./service-account.json

# Telegram Bot API (primary alerts) — from @BotFather. Leave empty until you have them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional WhatsApp fallback via CallMeBot (only used if Telegram is unset or fails).
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=
